{
  "manifest_version": 3,
  "name": "Night Mode for TCGplayer",
  "version": "1.0.2",
  "description": "Unofficial dark theme for tcgplayer.com that keeps card images true to color.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://*.tcgplayer.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tcgplayer.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Night Mode for TCGplayer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-night-mode": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Toggle night mode"
    }
  }
}
